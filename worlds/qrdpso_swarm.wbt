# Task markers.
DEF TASK0 Transform {
  translation 4 0 2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.15 0.10 roughness 0.6 }
      geometry Sphere { radius 0.22 }
    }
  ]
}

DEF TASK1 Transform {
  translation -4 1.5 2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.10 0.75 0.20 roughness 0.6 }
      geometry Sphere { radius 0.22 }
    }
