#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep 50
}

Viewpoint {
  orientation -0.32 0.61 0.73 1.95
  position 10 12 9
}

Background {
  skyColor [0.15 0.20 0.30]
}

DirectionalLight {
  direction -1 -1 -1
  intensity 1
}

Solid {
  translation 0 0 -0.05
  name "GROUND"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.35 0.35
        roughness 0.9
      }
      geometry Box {
        size 20 20 0.1
      }
    }
  ]
  boundingObject Box {
    size 20 20 0.1
  }
}
# ---------------------------------------------------------------------------
# Simple self-contained quadrotor models.
# These deliberately avoid the Crazyflie PROTO so the world is portable
# across Webots R2025a installations without external PROTO dependencies.
# The Supervisor controls their translation fields directly.
# ---------------------------------------------------------------------------

DEF DRONE0 Robot {
  translation 0 0 2
  name "DRONE0"
  children [
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.12 0.35 0.85
        roughness 0.45
        metalness 0.15
      }
      geometry Box {
        size 0.45 0.30 0.12
      }
    }
    Transform {
      translation 0.28 0 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 }
          geometry Cylinder { radius 0.10 height 0.035 }
        }
      ]
    }
    Transform {
      translation -0.28 0 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 }
          geometry Cylinder { radius 0.10 height 0.035 }
        }
      ]
    }
    Transform {
      translation 0 0.20 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 }
          geometry Cylinder { radius 0.10 height 0.035 }
        }
      ]
    }
    Transform {
      translation 0 -0.20 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.05 0.05 0.05 }
          geometry Cylinder { radius 0.10 height 0.035 }
        }
      ]
    }
  ]
}

